#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) writeonly buffer GridHeads {
    int gridHeads[];
};

layout(push_constant) uniform ClearParameters {
    uint cellCount;
} params;

void main() {
    const uint id = gl_GlobalInvocationID.x;
    if (id < params.cellCount) {
        gridHeads[id] = -1;
    }
}
