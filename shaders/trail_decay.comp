#version 450
#extension GL_GOOGLE_include_directive : require

// One invocation per stored value. Each touches only the value it owns, so the
// read-modify-write needs no ping-pong buffer and no barrier inside the pass;
// a second buffer becomes necessary only when diffusion is added and a cell
// starts reading its neighbours.

#include "simulation/trail_kernel.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer TrailField {
    uint trailValues[];
};

layout(push_constant) uniform DecayParameters {
    uint valueCount;
    float survival; // already exp(-rate * dt) on the host
} params;

void main() {
    const uint id = gl_GlobalInvocationID.x;
    if (id >= params.valueCount) {
        return;
    }
    const float faded = float(trailValues[id]) * params.survival;
    trailValues[id] = min(uint(faded), TrailCellCeiling);
}
