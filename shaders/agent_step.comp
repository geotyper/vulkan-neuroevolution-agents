#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint LightReceptorCount = 7;
const uint LightChannels = 4;
const uint TactileSectorCount = 8;
const uint TactileChannels = 2;
const uint MaxInputCount = 52;
const uint MaxHiddenCount = 20;
const uint MaxOutputCount = 8;
const float ForagePickupReward = 0.25;
const float ForageDeliveryReward = 4.0;

struct Agent {
    vec4 pose;
    vec4 motion;
    vec4 signal;
    vec4 target;
    vec4 metrics;
    vec4 penalties;
    vec4 internal;
    vec4 wallTouch0;
    vec4 wallTouch1;
    vec4 agentTouch0;
    vec4 agentTouch1;
};

layout(std430, set = 0, binding = 0) readonly buffer InputAgents {
    Agent inputAgents[];
};
layout(std430, set = 0, binding = 1) writeonly buffer OutputAgents {
    Agent outputAgents[];
};
layout(std430, set = 0, binding = 2) readonly buffer GenomeWeights {
    float weights[];
};
layout(std430, set = 0, binding = 3) readonly buffer GridHeads {
    int gridHeads[];
};
layout(std430, set = 0, binding = 4) readonly buffer GridLinks {
    int gridNext[];
};

layout(push_constant) uniform StepParameters {
    float deltaTime;
    float worldRadius;
    float thrust;
    float turnAcceleration;
    float linearDrag;
    float angularDrag;
    float sensorFieldOfView;
    float arrivalRadius;
    float maximumSpeed;
    float maximumAngularSpeed;
    float lightSensorRange;
    float lightExposure;
    float collisionRestitution;
    float collisionStiffness;
    float gridCellSize;
    float wallCollisionPenalty;
    uint agentCount;
    uint brainLayout;
    uint trialsPerGenome;
    uint worldShape;
    uint gridWidth;
    uint gridCellsPerWorld;
    uint agentCollisionsEnabled;
    uint agentLightEnabled;
    uint beaconScenario;
    uint beaconPhase;
    uint beaconPhaseChanged;
    float beaconMotionValue;
    float beaconRadiusRatio;
    float beaconMotionTime;
    float scenarioRate;
    uint beaconMotionSeed;
} params;

#include "worlds/world_scenarios.glsl"

uint activeBeaconCount() {
    return scenarioBeaconCount(params.beaconScenario);
}

vec2 activeBeaconPosition(Agent agent, uint beaconIndex) {
    return scenarioBeaconPosition(
        params.beaconScenario, agent, beaconIndex, params.beaconPhase, params.worldRadius,
        params.beaconMotionValue, params.beaconRadiusRatio, params.beaconMotionTime,
        params.scenarioRate, params.beaconMotionSeed);
}

vec3 activeBeaconColor(uint beaconIndex, uint trial) {
    return scenarioBeaconColor(params.beaconScenario, beaconIndex, params.beaconPhase, trial);
}

float nearestBeaconDistance(Agent agent, vec2 position) {
    return scenarioTargetDistance(
        params.beaconScenario, agent, position, params.beaconPhase, params.worldRadius,
        params.beaconMotionValue, params.beaconRadiusRatio, params.beaconMotionTime,
        params.scenarioRate, params.beaconMotionSeed);
}

float rangeFalloff(float distanceToLight) {
    const float fade =
        clamp((params.lightSensorRange - distanceToLight) /
                  (params.lightSensorRange * 0.25),
              0.0, 1.0);
    return fade * fade * (3.0 - 2.0 * fade);
}

ivec2 gridCoordinate(vec2 position) {
    return clamp(ivec2(floor((position + vec2(params.worldRadius)) / params.gridCellSize)),
                 ivec2(0), ivec2(int(params.gridWidth) - 1));
}

void recordTouch(inout Agent agent, uint sector, float strength, bool wall) {
    strength = clamp(strength, 0.0, 1.0);
    if (wall) {
        if (sector < 4) {
            agent.wallTouch0[sector] = max(agent.wallTouch0[sector], strength);
        } else {
            agent.wallTouch1[sector - 4] = max(agent.wallTouch1[sector - 4], strength);
        }
    } else {
        if (sector < 4) {
            agent.agentTouch0[sector] = max(agent.agentTouch0[sector], strength);
        } else {
            agent.agentTouch1[sector - 4] = max(agent.agentTouch1[sector - 4], strength);
        }
    }
}

uint contactSector(vec2 direction, float agentAngle) {
    float relative = mod(atan(direction.y, direction.x) - agentAngle + Tau / 16.0, Tau);
    if (relative < 0.0) {
        relative += Tau;
    }
    return uint(relative / Tau * 8.0) % 8;
}

void main() {
    const uint id = gl_GlobalInvocationID.x;
    if (id >= params.agentCount) {
        return;
    }

    Agent agent = inputAgents[id];
    const uint trial = id % params.trialsPerGenome;
    const uint world = uint(max(agent.penalties.w, 0.0) + 0.5);
    vec3 radiance[LightReceptorCount];
    for (uint receptor = 0; receptor < LightReceptorCount; ++receptor) {
        radiance[receptor] = vec3(0.0);
    }

    vec2 receptorDirections[LightReceptorCount];
    for (uint receptor = 0; receptor < LightReceptorCount; ++receptor) {
        const float fraction = float(receptor) / float(LightReceptorCount - 1);
        const float sensorAngle =
            agent.pose.z + (fraction - 0.5) * params.sensorFieldOfView;
        receptorDirections[receptor] = vec2(cos(sensorAngle), sin(sensorAngle));
    }
    for (uint beaconIndex = 0; beaconIndex < activeBeaconCount(); ++beaconIndex) {
        const vec2 toBeacon = activeBeaconPosition(agent, beaconIndex) - agent.pose.xy;
        const float beaconDistanceSquared = dot(toBeacon, toBeacon);
        const float beaconDistance = sqrt(max(beaconDistanceSquared, 1.0e-8));
        const vec2 beaconDirection = toBeacon / beaconDistance;
        const float normalizedDistanceSquared =
            beaconDistanceSquared / (params.worldRadius * params.worldRadius);
        const float beaconAttenuation = 1.0 / (1.0 + normalizedDistanceSquared * 2.0);
        const float beaconFalloff = rangeFalloff(beaconDistance);
        for (uint receptor = 0; receptor < LightReceptorCount; ++receptor) {
            const float alignment = max(dot(receptorDirections[receptor], beaconDirection), 0.0);
            radiance[receptor] += activeBeaconColor(beaconIndex, trial) *
                                  pow(alignment, 12.0) * beaconAttenuation * beaconFalloff;
        }
    }
    if (params.beaconScenario == 1 && params.beaconPhaseChanged != 0) {
        agent.metrics.w += agent.metrics.x - agent.metrics.y;
        agent.metrics.x = nearestBeaconDistance(agent, agent.pose.xy);
        agent.metrics.y = agent.metrics.x;
    }
    if (params.beaconScenario == 4 && agent.internal.y >= 0.5 &&
        forageHomeScenarioRelocated(params.beaconMotionTime, params.deltaTime)) {
        agent.metrics.w += max(agent.metrics.x - agent.metrics.y, 0.0);
        agent.metrics.x = nearestBeaconDistance(agent, agent.pose.xy);
        agent.metrics.y = agent.metrics.x;
    }

    vec2 positionCorrection = vec2(0.0);
    vec2 collisionVelocity = vec2(0.0);
    agent.wallTouch0 = vec4(0.0);
    agent.wallTouch1 = vec4(0.0);
    agent.agentTouch0 = vec4(0.0);
    agent.agentTouch1 = vec4(0.0);
    const ivec2 centerCell = gridCoordinate(agent.pose.xy);
    const int cellReach = int(ceil(params.lightSensorRange / params.gridCellSize));
    for (int offsetY = -cellReach; offsetY <= cellReach; ++offsetY) {
        for (int offsetX = -cellReach; offsetX <= cellReach; ++offsetX) {
            const ivec2 cell = centerCell + ivec2(offsetX, offsetY);
            if (any(lessThan(cell, ivec2(0))) ||
                any(greaterThanEqual(cell, ivec2(int(params.gridWidth))))) {
                continue;
            }
            const uint cellIndex = world * params.gridCellsPerWorld +
                                   uint(cell.y) * params.gridWidth + uint(cell.x);
            int otherId = gridHeads[cellIndex];
            uint guard = 0;
            while (otherId >= 0 && guard++ < params.agentCount) {
                if (uint(otherId) != id) {
                    const Agent other = inputAgents[otherId];
                    const vec2 toOther = other.pose.xy - agent.pose.xy;
                    const float distanceSquared = dot(toOther, toOther);
                    const float distanceToOther = sqrt(max(distanceSquared, 1.0e-8));
                    const vec2 directionToOther =
                        distanceSquared > 1.0e-8
                            ? toOther / distanceToOther
                            : vec2(id < uint(otherId) ? 1.0 : -1.0, 0.0);
                    if (params.agentLightEnabled != 0 &&
                        distanceToOther <= params.lightSensorRange && other.signal.a > 0.0) {
                        const float relativeDistance = distanceToOther / params.lightSensorRange;
                        const float attenuation =
                            rangeFalloff(distanceToOther) /
                            (1.0 + relativeDistance * relativeDistance * 8.0);
                        for (uint receptor = 0; receptor < LightReceptorCount; ++receptor) {
                            const float alignment =
                                max(dot(receptorDirections[receptor], directionToOther), 0.0);
                            radiance[receptor] += other.signal.rgb * other.signal.a * 0.02 *
                                                  pow(alignment, 12.0) * attenuation;
                        }
                    }

                    const float contactDistance = agent.pose.w + other.pose.w;
                    if (params.agentCollisionsEnabled != 0 &&
                        distanceToOther < contactDistance) {
                        const vec2 normal = -directionToOther;
                        const float penetration = contactDistance - distanceToOther;
                        positionCorrection +=
                            normal * penetration * 0.5 * params.collisionStiffness;
                        const float relativeNormalSpeed =
                            dot(agent.motion.xy - other.motion.xy, normal);
                        if (relativeNormalSpeed < 0.0) {
                            collisionVelocity += normal *
                                (-(1.0 + params.collisionRestitution) *
                                 relativeNormalSpeed * 0.5);
                        }
                        const float strength = 0.25 + penetration / contactDistance +
                                               max(-relativeNormalSpeed, 0.0) /
                                                   params.maximumSpeed;
                        recordTouch(agent, contactSector(directionToOther, agent.pose.z), strength,
                                    false);
                    }
                }
                otherId = gridNext[otherId];
            }
        }
    }

    float inputs[MaxInputCount];
    for (uint receptor = 0; receptor < LightReceptorCount; ++receptor) {
        const vec3 observed = vec3(1.0) - exp(-params.lightExposure * radiance[receptor]);
        const uint base = receptor * LightChannels;
        inputs[base] = observed.r;
        inputs[base + 1] = observed.g;
        inputs[base + 2] = observed.b;
        inputs[base + 3] = dot(observed, vec3(0.2126, 0.7152, 0.0722));
    }
    const uint tactileOffset = LightReceptorCount * LightChannels;
    for (uint sector = 0; sector < TactileSectorCount; ++sector) {
        const uint component = sector % 4;
        inputs[tactileOffset + sector * TactileChannels] =
            sector < 4 ? inputAgents[id].wallTouch0[component]
                       : inputAgents[id].wallTouch1[component];
        inputs[tactileOffset + sector * TactileChannels + 1] =
            sector < 4 ? inputAgents[id].agentTouch0[component]
                       : inputAgents[id].agentTouch1[component];
    }
    const uint selfOffset = tactileOffset + TactileSectorCount * TactileChannels;
    inputs[selfOffset] = clamp(length(agent.motion.xy) / params.maximumSpeed, 0.0, 1.0);
    inputs[selfOffset + 1] =
        clamp(agent.motion.z / params.maximumAngularSpeed, -1.0, 1.0);
    inputs[selfOffset + 2] = clamp(agent.motion.w, 0.0, 1.0);
    inputs[selfOffset + 3] = clamp(agent.signal.w, 0.0, 1.0);
    inputs[selfOffset + 4] = clamp(agent.internal.x, 0.0, 1.0);
    inputs[selfOffset + 5] = clamp(agent.internal.y, 0.0, 1.0);
    inputs[selfOffset + 6] = clamp(agent.internal.z, -1.0, 1.0);
    inputs[selfOffset + 7] = clamp(agent.internal.w, -1.0, 1.0);

    const uint genome = id / params.trialsPerGenome;
    const uint genomeStride = params.brainLayout & 0xfffu;
    const uint inputCount = (params.brainLayout >> 12u) & 0x3fu;
    const uint hiddenCount = (params.brainLayout >> 18u) & 0x3fu;
    const uint outputCount = (params.brainLayout >> 24u) & 0x1fu;
    const uint base = genome * genomeStride;
    float hidden[MaxHiddenCount];
    const uint hiddenBias = inputCount * hiddenCount;
    for (uint neuron = 0; neuron < hiddenCount; ++neuron) {
        float activation = weights[base + hiddenBias + neuron];
        for (uint inputIndex = 0; inputIndex < inputCount; ++inputIndex) {
            activation += weights[base + neuron * inputCount + inputIndex] * inputs[inputIndex];
        }
        hidden[neuron] = tanh(activation);
    }
    const uint outputWeights = hiddenBias + hiddenCount;
    const uint outputBias = outputWeights + hiddenCount * outputCount;
    float outputs[MaxOutputCount];
    for (uint neuron = 0; neuron < outputCount; ++neuron) {
        float activation = weights[base + outputBias + neuron];
        for (uint hiddenIndex = 0; hiddenIndex < hiddenCount; ++hiddenIndex) {
            activation += weights[base + outputWeights + neuron * hiddenCount + hiddenIndex] *
                          hidden[hiddenIndex];
        }
        outputs[neuron] = tanh(activation);
    }

    const float left = outputs[0];
    const float right = outputs[1];
    const vec2 forward = vec2(cos(agent.pose.z), sin(agent.pose.z));
    const float drive = 0.5 * (left + right) * params.thrust;
    agent.motion.xy += forward * drive * params.deltaTime;
    agent.motion.xy *= exp(-params.linearDrag * params.deltaTime);
    agent.motion.z += (right - left) * params.turnAcceleration * params.deltaTime;
    agent.motion.z *= exp(-params.angularDrag * params.deltaTime);
    agent.motion.xy += collisionVelocity;
    const float speed = length(agent.motion.xy);
    if (speed > params.maximumSpeed) {
        agent.motion.xy *= params.maximumSpeed / speed;
    }
    agent.motion.z = clamp(agent.motion.z, -params.maximumAngularSpeed,
                           params.maximumAngularSpeed);
    const float correctionLength = length(positionCorrection);
    if (correctionLength > agent.pose.w) {
        positionCorrection *= agent.pose.w / correctionLength;
    }
    agent.pose.xy += agent.motion.xy * params.deltaTime + positionCorrection;
    agent.pose.z += agent.motion.z * params.deltaTime;

    const float maximumCenterDistance = max(params.worldRadius - agent.pose.w, 0.0);
    if (params.worldShape == 0) {
        const float centerDistance = length(agent.pose.xy);
        if (centerDistance > maximumCenterDistance) {
            const vec2 normal = agent.pose.xy / centerDistance;
            agent.pose.xy = normal * maximumCenterDistance;
            const float outward = dot(agent.motion.xy, normal);
            if (outward > 0.0) {
                agent.motion.xy -= normal * outward * 1.5;
            }
            recordTouch(agent, contactSector(normal, agent.pose.z),
                        0.25 + max(outward, 0.0) / params.maximumSpeed, true);
        }
    } else {
        if (agent.pose.x > maximumCenterDistance) {
            agent.pose.x = maximumCenterDistance;
            recordTouch(agent, contactSector(vec2(1.0, 0.0), agent.pose.z),
                        0.25 + max(agent.motion.x, 0.0) / params.maximumSpeed, true);
            agent.motion.x = min(agent.motion.x, 0.0) - max(agent.motion.x, 0.0) * 0.5;
        } else if (agent.pose.x < -maximumCenterDistance) {
            agent.pose.x = -maximumCenterDistance;
            recordTouch(agent, contactSector(vec2(-1.0, 0.0), agent.pose.z),
                        0.25 - min(agent.motion.x, 0.0) / params.maximumSpeed, true);
            agent.motion.x = max(agent.motion.x, 0.0) - min(agent.motion.x, 0.0) * 0.5;
        }
        if (agent.pose.y > maximumCenterDistance) {
            agent.pose.y = maximumCenterDistance;
            recordTouch(agent, contactSector(vec2(0.0, 1.0), agent.pose.z),
                        0.25 + max(agent.motion.y, 0.0) / params.maximumSpeed, true);
            agent.motion.y = min(agent.motion.y, 0.0) - max(agent.motion.y, 0.0) * 0.5;
        } else if (agent.pose.y < -maximumCenterDistance) {
            agent.pose.y = -maximumCenterDistance;
            recordTouch(agent, contactSector(vec2(0.0, -1.0), agent.pose.z),
                        0.25 - min(agent.motion.y, 0.0) / params.maximumSpeed, true);
            agent.motion.y = max(agent.motion.y, 0.0) - min(agent.motion.y, 0.0) * 0.5;
        }
    }
    const float wallContactAmount = dot(agent.wallTouch0 + agent.wallTouch1, vec4(1.0));
    agent.penalties.x += wallContactAmount * params.wallCollisionPenalty;

    const float motorCost = (abs(left) + abs(right)) * params.deltaTime;
    const float signalIntensity = max(outputs[5], 0.0);
    const float signalCost = signalIntensity * params.deltaTime * 0.25;
    agent.motion.w = max(0.0, agent.motion.w - motorCost * 0.0008 - signalCost * 0.0008);
    agent.signal = vec4(outputs[2] * 0.5 + 0.5, outputs[3] * 0.5 + 0.5,
                        outputs[4] * 0.5 + 0.5, signalIntensity);
    if (outputCount >= 8u) {
        agent.internal.z = outputs[6];
        agent.internal.w = outputs[7];
    } else {
        agent.internal.z = 0.0;
        agent.internal.w = 0.0;
    }
    const float distance = nearestBeaconDistance(agent, agent.pose.xy);
    agent.metrics.y = min(agent.metrics.y, distance);
    agent.metrics.z += motorCost + signalCost;
    if (params.beaconScenario == 4) {
        if (agent.internal.y >= 0.5) {
            agent.internal.x = max(0.0, agent.internal.x - params.scenarioRate * params.deltaTime);
        }
        if (distance < params.arrivalRadius) {
            agent.metrics.w += max(agent.metrics.x - agent.metrics.y, 0.0);
            if (agent.internal.y >= 0.5) {
                agent.metrics.w += agent.internal.x * ForageDeliveryReward;
                agent.target.w = floor(max(agent.target.w, 0.0) + 0.5) + 1.0;
                agent.internal.x = 0.0;
                agent.internal.y = 0.0;
            } else {
                agent.metrics.w += ForagePickupReward;
                agent.internal.x = 1.0;
                agent.internal.y = 1.0;
            }
            agent.metrics.x = nearestBeaconDistance(agent, agent.pose.xy);
            agent.metrics.y = agent.metrics.x;
        }
        outputAgents[id] = agent;
        return;
    }
    if (params.beaconScenario == 2 || params.beaconScenario == 3) {
        const float visibleCloseness = clamp(1.0 - distance / params.lightSensorRange, 0.0, 1.0);
        agent.metrics.w += visibleCloseness * params.deltaTime * 0.25;
    }
    if (distance < params.arrivalRadius) {
        const uint completedMask = uint(max(agent.target.w, 0.0) + 0.5) |
                                   (1u << params.beaconPhase);
        agent.target.w = float(completedMask);
    }
    outputAgents[id] = agent;
}
